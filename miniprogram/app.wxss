page{background:#fafbf9;color:#242b27;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;letter-spacing:0}
view,text,button,input{box-sizing:border-box}button{font-size:28rpx;font-weight:600;line-height:1.4;border-radius:8rpx;margin:0;padding:24rpx 28rpx;background:#edf0ed;color:#242b27}button::after{border:0}button[disabled]{opacity:.45}input{height:84rpx;min-width:0;background:#f1f3ef;border-radius:8rpx;padding:0 20rpx;font-size:30rpx}textarea{box-sizing:border-box;width:100%;background:#f1f3ef;padding:20rpx;font-size:24rpx;min-height:180rpx}
.page{padding:36rpx 32rpx 60rpx}.eyebrow{font-size:21rpx;color:#717b73;font-weight:600}.title{font-size:48rpx;font-weight:750;margin:12rpx 0 28rpx}.subtitle{font-size:25rpx;color:#738075;line-height:1.6}.section{margin-top:40rpx;padding-top:28rpx;border-top:1rpx solid #e1e5de}.section-title{font-size:33rpx;font-weight:650;margin-bottom:24rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.grow{flex:1;min-width:0}.muted{color:#778077;font-size:24rpx;line-height:1.65}.primary{background:#d94a48;color:#fff}.secondary{background:#232e29;color:#fff}.small{padding:16rpx 20rpx;font-size:24rpx;min-height:64rpx}.segments{display:flex;background:#eaf0e9;padding:6rpx;border-radius:8rpx;gap:6rpx}.segments button{flex:1;background:transparent;font-size:27rpx;padding:22rpx 6rpx;min-width:0}.segments .active{background:#fff;color:#c13c3b;box-shadow:0 2rpx 8rpx #24322812}.tag{font-size:23rpx;background:#e8efe8;color:#466151;padding:8rpx 14rpx;border-radius:6rpx;display:inline-block}.tag.red{background:#f9e9e6;color:#b9403d}.notice{border-left:5rpx solid #d6a348;padding:20rpx 24rpx;background:#f8f4e9;font-size:25rpx;line-height:1.7;margin:24rpx 0}.error{color:#b33737;line-height:1.7;font-size:25rpx;margin:18rpx 0;word-break:break-word}.field{margin:22rpx 0}.label{display:block;color:#5e6b62;font-size:25rpx;margin-bottom:12rpx}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:24rpx}.chips{display:flex;flex-wrap:wrap;gap:12rpx}.chips button{padding:15rpx 22rpx;font-size:24rpx;min-height:66rpx;background:#eef1eb}.chips .active{background:#dce8dd;color:#254b35}.exercise{padding:26rpx 0;border-bottom:1rpx solid #e2e6df}.exercise-name{font-size:30rpx;font-weight:650}.exercise-meta{font-size:24rpx;color:#717c73;margin-top:10rpx}.metric{font-size:50rpx;font-weight:700;font-variant-numeric:tabular-nums}.unit{font-size:23rpx;font-weight:400;color:#778077}.space{margin-top:24rpx}.empty{padding:36rpx 0;line-height:1.8}.footer-note{margin-top:32rpx;color:#858c85;font-size:22rpx;line-height:1.7}.modal-mask{position:fixed;inset:0;background:#14261c77;z-index:100;display:flex;align-items:flex-end}.modal{width:100%;max-height:85vh;background:#fff;padding:32rpx 32rpx 60rpx;overflow:auto;border-radius:16rpx 16rpx 0 0}.step{margin:24rpx 0;line-height:1.8}.number{color:#ce4946;margin-right:16rpx;font-weight:700}.link{color:#bd4441;background:transparent}.schedule{display:flex;gap:12rpx;overflow-x:auto;padding-bottom:12rpx}.schedule-item{flex-shrink:0;min-width:118rpx;border-left:3rpx solid #d8e2d6;padding:10rpx 16rpx;font-size:25rpx}.divider{margin-top:24rpx}
