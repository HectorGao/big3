<view class="page"><view class="eyebrow">TRAINING LOG / 每一步都算数</view><view class="title">力量，有迹可循。</view><view class="error" wx:if="{{error}}">{{error}}</view><view class="grid2 summary"><view><view class="muted">累计训练</view><view class="metric">{{total}} <text class="unit">次</text></view></view><view><view class="muted">当前筛选记录负荷</view><view class="metric">{{tonnage}} <text class="unit">kg·次</text></view></view></view><view class="muted">按录入重量 × 次数统计，不含计时动作、自身体重及双侧换算。</view>
<view class="chips space"><button class="{{filter==='all'?'active':''}}" data-id="all" bindtap="filter">全部</button><button wx:for="{{lifts}}" wx:key="id" class="{{filter===item.id?'active':''}}" data-id="{{item.id}}" bindtap="filter">{{item.name}}</button></view>
<view wx:for="{{history}}" wx:key="id" class="exercise" data-id="{{item.id}}" bindtap="detail" role="button"><view class="row"><text class="exercise-name">{{item.name}} · {{item.label}}</text><text class="tag">RPE {{item.rpe}}</text></view><view class="exercise-meta">{{item.date}} · {{item.count}} 组 · {{item.volume}} kg·次</view><view class="muted">{{item.completed?'主项目标已完成':'部分完成 · 周期未推进'}}</view></view>
<view wx:if="{{!history.length}}" class="empty"><view class="section-title">还没有训练记录</view><view class="muted">完成的每一组，会成为下一次计划的参考。</view><button class="primary space" bindtap="train">开始一次训练 →</button></view></view>
<view wx:if="{{detail}}" class="modal-mask" bindtap="close"><view class="modal" catchtap="noop"><view class="row"><view class="section-title">{{detail.name}} · {{detail.date}}</view><button class="small" bindtap="close">关闭</button></view><view wx:for="{{detail.sets}}" wx:key="key" class="exercise row"><text>{{item.name || item.exercise}}</text><text>{{item.weight}} kg × {{item.reps}} {{item.unit || '次'}}</text></view><button class="link space" data-id="{{detail.id}}" bindtap="remove">删除这次记录</button></view></view>
