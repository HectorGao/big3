<view class="page"><view class="eyebrow">MUSCLE ATLAS / 动作库</view><view class="title">从肌肉，找到动作。</view><view class="segments"><button class="{{side==='front'?'active':''}}" data-side="front" bindtap="side">正面</button><button class="{{side==='back'?'active':''}}" data-side="back" bindtap="side">背面</button></view>
<view class="map-wrap"><muscle-map side="{{side}}" selected="{{selected}}" bindpick="pick"/></view>
<view class="chips"><button wx:for="{{muscles}}" wx:key="id" class="{{muscle===item.id?'active':''}}" data-id="{{item.id}}" bindtap="pick">{{item.name}}</button></view>
<view class="section"><view class="row"><view class="section-title">{{muscleName}}</view><picker range="{{equipment}}" value="{{equipmentIndex}}" bindchange="equipment"><view class="tag">{{equipment[equipmentIndex]}} ↓</view></picker></view><input type="text" placeholder="搜索当前肌群动作" value="{{query}}" bindinput="search" aria-label="搜索动作"/>
<view wx:for="{{exercises}}" wx:key="id" class="exercise row" data-id="{{item.id}}" bindtap="showDetail" role="button" aria-label="查看{{item.name}}"><view class="grow"><view class="exercise-name">{{item.name}}</view><view class="exercise-meta">{{item.en}}</view></view><text class="tag">{{item.equipment}}</text><text>→</text></view><view wx:if="{{!exercises.length}}" class="empty muted">没有符合条件的动作，请调整器械或搜索词。</view><button class="secondary space" bindtap="train">进入关联主项训练 →</button></view></view>
<view wx:if="{{detail}}" class="modal-mask" bindtap="closeDetail"><view class="modal" catchtap="noop"><view class="row"><view class="section-title">{{detail.name}}</view><button class="small" bindtap="closeDetail">关闭</button></view><text class="muted">{{detail.en}} · {{detail.equipment}}</text><exercise-figure exercise-id="{{detail.id}}" label="{{detail.name}}"/><view class="muted">起始与结束姿势示意；请同时阅读下方动作要点。</view><view class="step" wx:for="{{detail.steps}}" wx:key="*this"><text class="number">0{{index+1}}</text>{{item}}</view><view class="notice">{{detail.caution}}</view></view></view>
