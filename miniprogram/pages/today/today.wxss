.overview{display:flex;height:400rpx;overflow:hidden;align-items:center;margin:30rpx 0}.overview-copy{width:53%;flex-shrink:0;z-index:1}.work-title{font-size:38rpx;font-weight:700;margin:24rpx 0}.overview-map{width:48%;transform:scale(.83);transform-origin:center center}.weight{font-size:30rpx;font-weight:650;white-space:nowrap}.warmup{padding:20rpx;background:#eef2ec}.warmup-line{display:block;margin:8rpx 0}.set-row{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(0,1fr) minmax(0,1fr) 74rpx;gap:12rpx;align-items:center;padding:20rpx 0;border-bottom:1rpx solid #e3e7e0}.set-row input{padding:0 12rpx;width:100%;font-size:28rpx}.set-label{color:#7a827a;font-size:23rpx}.set-name{font-size:24rpx;line-height:1.4}.check{background:none;padding:12rpx;display:flex;justify-content:center;align-items:center}.done{background:#edf3e8}.timer{padding:24rpx;background:#e8efe4;margin-top:24rpx}
.lift-picker{background:transparent;padding:0;gap:14rpx}.lift-picker button{padding:0;border:1rpx solid #e0e5df;background:#fff;overflow:hidden}.lift-picker button.active{border-color:#d94a48}.lift-photo{position:relative;height:120rpx;overflow:hidden}.lift-photo image{position:absolute;width:300%;top:0}.lift-label{padding:16rpx 8rpx}.overview-map{transform:none}
.plan-inputs{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:14rpx;margin-top:24rpx}.plan-inputs input{width:100%;padding:0 14rpx}.set-advice{grid-column:1 / -1}.rir-choice{padding:14rpx 18rpx;background:#eef3e8;font-size:24rpx}
.fatigue-summary{background:#eef3e8;padding:22rpx;margin:16rpx 0;border-left:4rpx solid #648359;line-height:1.8;font-size:25rpx}
.today-mark{color:#c43d46;font-weight:700}
.date-controls{display:flex;flex-wrap:wrap;gap:16rpx;align-items:center;margin:24rpx 0}
.date-controls picker{padding:16rpx;background:#fff;border:1rpx solid #d5d9d5}
.set-row input{min-width:0;width:100%}
.training-equipment{padding:20rpx 0;margin-bottom:24rpx;border-bottom:1rpx solid #dce3dc}.training-equipment checkbox-group{display:flex;flex-wrap:wrap;gap:16rpx}.training-equipment label{display:flex;align-items:center;min-height:72rpx}
.fold-all{margin:20rpx 0}.fold-actions{display:flex;flex-direction:column;gap:8rpx;flex-shrink:0}.fold-actions button{min-width:100rpx;min-height:72rpx}.plan-fold-summary{display:flex;flex-wrap:wrap;gap:12rpx 22rpx;font-size:26rpx;color:#425c4b;margin-top:12rpx}.exercise.collapsed{padding:20rpx 0}.plan-fold-summary text:first-child{font-weight:600}
