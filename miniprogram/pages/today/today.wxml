<view class="page">
  <view class="date-controls"><picker mode="date" value="{{selectedDate}}" bindchange="chooseDate"><view>训练日期：{{selectedDate}}</view></picker><button bindtap="chooseToday">今天</button><picker range="{{['按规划','技术日','容量日','强度日','恢复日','冲刺日']}}" bindchange="chooseMode"><view>训练日类型：{{freeMode || '按规划'}}</view></picker></view>
  <view class="row"><text class="eyebrow">THREE LIFT / 训练日志</text><text class="muted">{{date}}</text></view>
  <view class="title">今天，练什么。</view>
  <view class="segments lift-picker"><button wx:for="{{lifts}}" wx:key="id" class="{{lift===item.id?'active':''}}" data-id="{{item.id}}" bindtap="changeLift"><view class="lift-photo"><image src="/assets/equipment.png" mode="widthFix" style="left:{{index * -100}}%" /></view><view class="lift-label">{{item.name}}</view></button></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <button class="small" bindtap="manual">补记实际训练</button><view wx:if="{{!session && testStatus}}" class="section"><view class="muted">{{testStatus.reason}}</view><button bindtap="requestTest" disabled="{{!testStatus.eligible}}">申请测试准备</button></view>
  <view wx:if="{{session && showSession}}" class="section"><picker mode="date" end="{{date}}" value="{{session.actualDate || date}}" bindchange="actualDate"><view>实际训练日期：{{session.actualDate || date}} ↓</view></picker><view wx:if="{{session.mode==='test'}}"><view class="notice">失败、疼痛或动作失控后停止加重，最多三次尝试。</view><button bindtap="nextAttempt">下一次尝试</button><button bindtap="stopTest">停止测试</button></view><view wx:for="{{session.sets}}" wx:key="key" class="row"><text>{{item.name}} 第{{item.index}}组</text><view>动作合格<switch checked="{{item.quality!==false}}" data-index="{{index}}" data-field="quality" bindchange="flag"/></view><view>成功<switch checked="{{item.success!==false}}" data-index="{{index}}" data-field="success" bindchange="flag"/></view></view></view>
  <view wx:if="{{session && !showSession}}" class="notice row"><text>有一份训练正在进行，可自由查看其他计划。</text><button class="small" bindtap="resume">继续当前训练</button></view>
  <view wx:if="{{plan && !(session && showSession)}}">
    <view class="overview"><view class="overview-copy"><view class="tag {{plan.mode==='intensity'?'red':''}}">{{plan.label}}</view><view class="work-title">{{lift==='squat'?'下肢力量':lift==='bench'?'上肢推力':'后侧链力量'}}</view><view wx:if="{{plan.exercises.length}}" class="metric">{{plan.estimatedMinutes}}<text class="unit"> 分钟</text></view><view class="muted" wx:if="{{plan.rpe}}">目标 RPE {{plan.rpe}}</view><button class="small link space" bindtap="atlas">查看目标肌群 →</button></view><view class="overview-map"><muscle-map height="420" side="{{side}}" selected="{{selected}}" bindpick="atlas" /></view></view>
    <view wx:if="{{plan.blockedReason}}" class="notice">{{plan.blockedReason}}</view><view class="muted">{{plan.reason}}</view><view wx:if="{{plan.estimate}}" class="notice">{{plan.estimate.measured?'实测 PB':'估算单次 PB'}} {{plan.estimate.range}} kg · 保守训练基准 {{plan.trainingMax}} kg</view>
    <view wx:if="{{plan.mode==='setup'}}" class="space"><button class="primary" bindtap="profile">填写资料，生成计划</button><view class="footer-note">没有 PB 也可以开始。首版面向健康成年人。</view></view>
    <view wx:else>
      <view class="section"><view class="section-title">训练前状态</view><view class="row"><text>疲劳程度</text><text class="tag">{{readiness.fatigue}} / 5</text></view><slider min="1" max="5" step="1" value="{{readiness.fatigue}}" activeColor="#52765b" bindchange="fatigue" aria-label="疲劳程度"/><view class="fatigue-summary"><view class="exercise-name">{{plan.fatigue.value}} · {{plan.fatigue.label}}</view><view class="muted">{{plan.fatigue.description}}</view><view>{{plan.fatigue.action}}</view></view><view wx:for="{{fatigueLevels}}" wx:key="value" class="muted">{{item.value}} {{item.label}} · {{item.description}}</view><view class="row"><text>今天有疼痛或明显不适</text><switch checked="{{readiness.pain}}" color="#d94a48" bindchange="pain" aria-label="疼痛或明显不适"/></view></view>
      <view wx:if="{{plan.exercises.length}}" class="section"><view class="row"><text class="section-title">{{plan.previewOnly?'后续参考计划':'今日动作'}}</text><text class="muted">{{plan.exercises.length}} 个动作</text></view><view class="warmup"><text wx:for="{{plan.warmup}}" wx:key="*this" class="muted warmup-line">{{item}}</text></view>
        <view wx:for="{{plan.exercises}}" wx:key="id" class="exercise">
          <view class="row"><view class="grow" bindtap="showDetail" data-id="{{item.id}}"><view class="exercise-name"><text class="number">0{{index+1}}</text>{{item.name}}</view><view class="exercise-meta">休息 {{item.rest}} 秒 · {{item.unit==='秒'?'保持姿势与呼吸':'保留 '+item.rir+' 次余力'}}</view></view><button class="small link" data-id="{{item.id}}" bindtap="showDetail">动作图</button></view>
          <view class="plan-inputs"><view><text class="label">{{item.weightUnit}}</text><input type="digit" value="{{item.weight}}" data-index="{{index}}" data-field="weight" bindblur="editPlan" aria-label="{{item.name}}计划重量"/></view><view><text class="label">组数</text><input type="number" value="{{item.sets}}" data-index="{{index}}" data-field="sets" bindblur="editPlan" aria-label="{{item.name}}计划组数"/></view><view><text class="label">{{item.unit}}</text><input type="number" value="{{item.reps}}" data-index="{{index}}" data-field="reps" bindblur="editPlan" aria-label="{{item.name}}计划次数"/></view></view>
          <view class="row space"><text class="muted">{{item.source}}</text><button class="small link" wx:if="{{!item.main && item.alternatives.length}}" data-index="{{index}}" bindtap="replace">替换</button></view><view class="muted" wx:if="{{item.advice}}">{{item.advice}}</view>
        </view>
        <view class="notice">{{straightSets}}</view><button class="primary space" bindtap="start" disabled="{{!plan.canStart || !!session}}">{{plan.previewOnly?'仅预览 · 当天重新评估':session?'请先结束当前训练':'开始本次训练 →'}}</button>
      </view>
      <view wx:else class="notice">{{plan.reason}}</view>
    </view>
    <view wx:if="{{upcoming.length}}" class="section"><view class="section-title">接下来</view><view class="schedule"><view wx:for="{{upcoming}}" wx:key="date" class="schedule-item"><view class="muted">{{item.date}}</view><view>{{item.name}}</view></view></view><view class="muted">按可训练日轮换；当天负荷在训练前重新评估。</view></view>
  </view>
  <view wx:if="{{session && showSession}}" class="section"><view class="row"><text class="section-title">训练进行中</text><text class="tag">{{session.date}}</text></view><view wx:if="{{session.date !== date}}" class="notice">训练草稿已跨日。请先保存已完成组或放弃，再重新评估今天的计划。</view><view class="muted">填写实际重量与次数后勾选。自重填 0，哑铃填单只重量；单侧动作每侧计次。勾选完成后保存该组。</view>
    <view wx:if="{{remaining>0}}" class="timer row"><view><text class="muted">组间休息 </text><text class="metric">{{timerText}}</text></view><button class="small" bindtap="skipTimer">跳过</button></view>
    <view class="set-row set-label"><text>动作 / 组</text><text>kg</text><text>次 / 秒</text><text>完成</text></view>
    <view wx:for="{{session.sets}}" wx:key="key" class="set-row {{item.done?'done':''}}"><view><view class="set-name">{{item.name}}</view><text class="muted">第 {{item.index}} 组</text></view><input type="digit" value="{{item.weight}}" placeholder="实际" data-index="{{index}}" data-field="weight" bindinput="editSet" aria-label="{{item.name}}第{{item.index}}组重量"/><input type="number" value="{{item.reps}}" data-index="{{index}}" data-field="reps" bindinput="editSet" aria-label="{{item.name}}第{{item.index}}组次数"/><button class="check" data-index="{{index}}" bindtap="toggleSet" aria-label="{{item.name}}第{{item.index}}组{{item.done?'取消完成':'完成'}}"><icon type="{{item.done?'success':'circle'}}" size="23" color="{{item.done?'#52765b':'#adb5ad'}}"/></button><view class="set-advice"><view class="muted">{{item.weightUnit}} <text wx:if="{{item.unit!=='秒'}}">· 目标保留 {{item.targetRir}} 次余力</text></view><picker wx:if="{{item.unit!=='秒'}}" range="{{rirOptions}}" value="{{item.rir===null || item.rir===undefined?0:item.rir+1}}" data-index="{{index}}" bindchange="setRir"><view class="rir-choice">实际剩余次数：{{item.rir===null || item.rir===undefined?'未记录':item.rir}} ↓</view></picker><view wx:if="{{item.advice}}" class="muted">{{item.advice}}</view></view></view>
    <view class="section"><view class="row"><text>本次主项用力程度 RPE</text><text class="tag">{{session.rpe}} / 10</text></view><slider min="1" max="10" step="1" value="{{session.rpe}}" bindchange="setRpe" activeColor="#52765b"/><view class="muted">7 ≈ 还能做 3 次；8 ≈ 还能做 2 次；10 ≈ 无法再完成。</view><button class="primary space" bindtap="finish">结束并保存训练</button><button class="link space" bindtap="discard">放弃本次</button></view>
  </view>
  <view class="footer-note">一般健身参考，不替代专业评估。疼痛时停止训练；卧推与深蹲请使用保护装置。训练模板与估算不保证个人适用性。</view>
</view>
<view wx:if="{{manualEntry}}" class="modal-mask"><view class="modal"><view class="section-title">补记已经发生的训练</view><view class="notice">这不是训练许可；疼痛时应停止。每次补记一组。</view><picker mode="date" end="{{date}}" data-field="date" bindchange="manualField"><view>{{manualEntry.date}} ↓</view></picker><picker range="{{manualExercises}}" range-key="name" value="{{manualIndex}}" bindchange="manualExercise"><view>{{manualExercises[manualIndex].name}} · {{manualExercises[manualIndex].weightUnit}} ↓</view></picker><input type="digit" value="{{manualEntry.weight}}" data-field="weight" bindinput="manualField" aria-label="实际重量"/><input type="number" value="{{manualEntry.reps}}" data-field="reps" bindinput="manualField" aria-label="实际次数或秒"/><button bindtap="saveManual" class="primary">保存实际组</button></view></view>
<view wx:if="{{detail}}" class="modal-mask" bindtap="closeDetail"><view class="modal" catchtap="noop"><view class="row"><view class="section-title">{{detail.name}}</view><button class="small" bindtap="closeDetail">关闭</button></view><text class="muted">{{detail.en}} · {{detail.equipment}}</text><exercise-figure exercise-id="{{detail.id}}" label="{{detail.name}}"/><view class="muted">起始与结束姿势示意；请同时阅读下方动作要点。</view><view class="step" wx:for="{{detail.steps}}" wx:key="*this"><text class="number">0{{index+1}}</text>{{item}}</view><view class="notice">{{detail.caution}}</view></view></view>
