<view class="page"><view class="eyebrow">TRAINING OVERVIEW</view><view class="title">训练概览</view><view class="today-mark">今天 {{today}}</view><picker mode="date" value="{{viewDate}}" bindchange="chooseDate"><view>查看日期：{{viewDate}}</view></picker><view wx:if="{{error}}" class="error">{{error}}</view>
<view wx:for="{{report.achievements}}" wx:key="id" class="section"><view class="section-title">{{item.name}}</view><view class="metric">{{item.measured?item.measured.weight:'—'}}<text class="muted"> kg 实测单次最佳</text></view><view class="muted">{{item.measured?item.measured.date+' · '+item.measured.source:'尚无单次 PB'}}</view><view>e1RM {{item.latest?item.latest.range+' kg':'—'}}</view><view class="muted" wx:if="{{item.latest}}">{{item.latest.weight}} kg × {{item.latest.reps}} · {{item.latest.confidence}}</view><scroll-view scroll-x><view class="points"><view wx:for="{{item.points}}" wx:for-item="point" wx:key="date"><view>{{point.low}}–{{point.high}}</view><view class="muted">{{point.date}}</view></view></view></scroll-view></view>
<view class="section"><view class="section-title">下一次建议</view><view wx:if="{{report.next}}">{{report.next.date}} · {{report.next.label}}<view class="muted">{{report.next.reason}}</view><button data-date="{{report.next.date}}" bindtap="open">查看逐组计划</button></view><button bindtap="preview">查看该日 / 修改类型</button><button bindtap="train" class="primary space">自由选择训练</button></view>
<view class="section"><view class="section-title">未来两周</view><view class="calendar"><button wx:for="{{report.schedule}}" wx:key="date" class="day {{item.mode}} {{item.today?'today':''}} {{item.selected?'selected-date':''}}" data-date="{{item.date}}" bindtap="open"><view class="muted">{{item.date}}</view><view>{{item.name}}</view><view>{{item.lift?item.label:''}}</view></button></view></view>
<view class="section"><view class="section-title">恢复与反馈</view><view class="muted">根据负荷、时间与主观反馈分档估计，不是生理恢复率。</view><button bindtap="feedback">记录今天状态</button><view wx:for="{{report.recovery}}" wx:key="id" class="recovery"><view class="row"><text>{{item.name}}</text><text class="tag">{{item.label}}</text></view><view class="muted">{{item.reason}}</view></view></view>
<view class="section"><view class="section-title">近八周主项训练量</view><view wx:for="{{report.trends}}" wx:key="id"><view>{{item.name}} · 近28天 {{item.count}} 次</view><view class="bars"><view wx:for="{{item.weeks}}" wx:for-item="week" wx:key="end"><view class="bar" style="height:{{week.height}}rpx"/><view>{{week.sets}}组</view><view>{{week.volume}}</view><view>{{week.end}}</view></view></view></view><view class="muted">各主项单独统计：工作组 / kg·次。不混合器械标重。</view></view>
<view class="section"><view class="section-title">最近训练</view><view wx:for="{{report.recent}}" wx:key="id" class="recovery">{{item.date}} · {{item.lift==='squat'?'深蹲':item.lift==='bench'?'卧推':'硬拉'}} · {{item.sets.length}} 组 · {{item.completed?'完成目标':'部分完成'}}</view></view>
<view class="section row"><text>主动开启单次 PB 测试</text><switch checked="{{maxTesting}}" bindchange="testing"/></view><view class="muted">默认采用次极限评估；单次测试仅向满足条件的有经验用户推荐。</view></view>
<view wx:if="{{detail}}" class="modal-mask" bindtap="close"><scroll-view scroll-y class="modal" catchtap="noop"><view class="section-title">{{detail.date}} · {{detail.label}}</view><view class="notice">{{detail.reason}}</view><view wx:for="{{detail.exercises}}" wx:key="id" class="section"><view>{{item.name}}</view><view wx:for="{{item.prescribedSets}}" wx:for-item="set" wx:key="index">第{{set.index}}组 · {{set.weight===null?'待试重':set.weight+' '+item.weightUnit}} × {{set.reps}} {{item.unit}} · {{set.rir===null?'保持姿势':'预计还能做 '+set.rir+' 次'}} · {{set.rest}}秒</view></view><view wx:if="{{detail.lift}}"><button bindtap="train" class="primary space">今天练此项目</button><picker mode="date" start="{{detail.date}}" bindchange="defer"><button>延期</button></picker><button bindtap="skip">跳过这一天</button></view><button bindtap="close">关闭</button></scroll-view></view>
<view wx:if="{{feedback}}" class="modal-mask"><scroll-view scroll-y class="modal"><view class="section-title">今天的恢复反馈</view><view>疲劳 {{feedback.fatigue}} / 5</view><slider min="1" max="5" value="{{feedback.fatigue}}" bindchange="fatigue"/><view class="row">疼痛或不适<switch checked="{{feedback.pain}}" bindchange="pain"/></view><view wx:for="{{sorenessRows}}" wx:key="id"><view>{{item.name}} · 酸痛 0无 / 1轻微 / 2明显 / 3影响动作</view><slider min="0" max="3" value="{{item.value}}" data-id="{{item.id}}" bindchange="soreness"/></view><button bindtap="saveFeedback" class="primary">保存并重新规划</button></scroll-view></view>
