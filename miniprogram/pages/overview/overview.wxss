.calendar{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2rpx;background:#e7e7ec}.calendar .day{background:white;font-size:24rpx;border-radius:0;padding:16rpx 6rpx;min-height:160rpx;width:100%;margin:0;line-height:1.8}.day.volume{border-top:5rpx solid #548a7d}.day.intensity,.day.test{border-top:5rpx solid #c84c7b}.recovery{padding:22rpx 0;border-bottom:1rpx solid #e8e8ed}.bars{display:flex;align-items:flex-end;gap:6rpx;min-height:190rpx;margin:28rpx 0}.bars>view{flex:1;min-width:0;text-align:center;font-size:16rpx;overflow-wrap:anywhere}.bar{background:#d77999;max-width:35rpx;margin:auto}.points{display:flex;gap:24rpx;padding:20rpx 0;white-space:nowrap}.points>view{font-size:24rpx}.modal{box-sizing:border-box;max-height:85vh}.metric{font-size:44rpx}
.today-mark,.day.today .muted{color:#c43d46;font-weight:700}
.day.today{outline:3rpx solid #c43d46;outline-offset:-4rpx}
.day.selected-date{box-shadow:inset 0 0 0 2rpx #287657}
.day.volume{background:#e5efdf}.day.intensity{background:#f3dce7}.day.recovery,.day.deload{background:#fcf1cb}.day.test{background:#e9ddf0}.day.completed{background:#d0e6db;color:#184d36}.day.rest{background:#eee;color:#555}
