<view class="page"><view class="title">{{exercise.name}}</view><view class="muted">{{exercise.en}} · {{exercise.weightUnit}}</view><view wx:if="{{error}}" class="notice">{{error}}</view><view wx:if="{{src}}" class="teaching-frame"><view class="teaching-crop" style="width:{{exercise.media.frames[phase].viewportWidth}}%;height:{{exercise.media.frames[phase].viewportHeight}}%;left:{{exercise.media.frames[phase].viewportLeft}}%;top:{{exercise.media.frames[phase].viewportTop}}%"><image src="{{src}}" mode="scaleToFill" style="width:{{exercise.media.frames[phase].width}}%;height:{{exercise.media.frames[phase].height}}%;left:{{exercise.media.frames[phase].left}}%;top:{{exercise.media.frames[phase].top}}%" binderror="imageError" bindtap="zoom"/></view></view><view class="row"><button bindtap="previous" aria-label="上一阶段">‹</button><text>{{phase+1}} / {{phases.length}} · {{phases[phase]}}</text><button bindtap="next" aria-label="下一阶段">›</button><button bindtap="zoom">放大</button></view><view class="notice">{{exercise.media.phaseCues[phase]}}</view><view class="section-title">动作要点</view><view wx:for="{{exercise.steps}}" wx:key="*this" class="step">{{index+1}}. {{item}}</view><view class="notice">{{exercise.caution}}</view><view>{{exercise.purpose}}</view><view class="muted">腰背负担：{{exercise.fatigueTags}}。替代条件：{{exercise.alternativeCondition}}</view><view class="muted">原创生成教学图，不能替代现场动作指导。</view></view>
